AIRP_APP_NAME="AIRP Backend API"
AIRP_ENVIRONMENT=development
AIRP_LOG_LEVEL=INFO
AIRP_DATABASE_URL=postgresql+asyncpg://airp:airp@localhost:5432/airp
AIRP_POSTGRES_PORT=5432
AIRP_REDIS_URL=redis://localhost:6379/0
AIRP_ALLOWED_ORIGINS=[]
AIRP_API_MAX_REQUEST_BODY_BYTES=1048576
AIRP_READINESS_PROBE_TIMEOUT_SECONDS=10

# Microsoft Entra ID auth. These are required when AIRP_AUTH_ENABLED=true.
AIRP_AUTH_ENABLED=true
AIRP_ENTRA_TENANT_ID=
AIRP_ENTRA_CLIENT_ID=
AIRP_ENTRA_ALLOWED_ISSUERS=[]
AIRP_ENTRA_DISCOVERY_CACHE_TTL_SECONDS=3600
AIRP_ENTRA_DISCOVERY_TIMEOUT_SECONDS=5

# IBM Bob CLI (highest priority when AIRP_BOB_AUTH_TOKEN is set).
# Install: https://ibm.biz/bob-cli-install  (npm package 'bobshell')
# instance_id / team_id are optional — omitted flags fall back to the account
# default. Both come from the Bob console; bobshell 1.0.6 has no CLI command
# that prints them.
#
# AIRP_BOB_CLI_PATH accepts either form:
#   bob                                                 npm's PATH shim (local dev)
#   /usr/local/lib/node_modules/bobshell/bundle/bob.js  the bundle itself
# A path ending in .js is spawned through 'node', so a bundle copied into an
# image works without the executable bit. Node must then be on PATH.
#
# The CLI is spawned in a scratch directory under TMPDIR rather than the app's
# cwd, because it writes session state to <cwd>/.bob on every call. TMPDIR must
# be writable — a read-only container rootfs needs a tmpfs or emptyDir mount.
AIRP_BOB_AUTH_TOKEN=
AIRP_BOB_CLI_PATH=bob
AIRP_BOB_INSTANCE_ID=
AIRP_BOB_TEAM_ID=
# ARCHIVED — AIRP_BOB_BASE_URL was used by the old HTTP client and is no longer read.
# It is kept here so existing .env files remain valid, but has no effect.
# AIRP_BOB_BASE_URL=https://api.us-east.bob.ibm.com

# Anthropic-compatible LLM gateway. Used if AIRP_BOB_AUTH_TOKEN is not set.
AIRP_ANTHROPIC_BASE_URL=
AIRP_ANTHROPIC_AUTH_TOKEN=

# GenAI Hub fallback (used when neither Bob nor Anthropic is configured).
# Also used for embeddings when Bob or Anthropic is the chat client.
AIRP_GATEWAY_BASE_URL=
AIRP_GATEWAY_API_KEY=
# Bob model names, passed straight through as 'bob --model <name>'.
# To list what your entitlement exposes, query the Bob API host directly:
#   curl -H "Authorization: Apikey $AIRP_BOB_AUTH_TOKEN" \
#        https://api.us-east.bob.ibm.com/inference/v1/model/info
# (that host is the REST API, not the CLI — the app no longer calls it)
AIRP_LLM_MONITORING_MODEL=haiku-4.5
AIRP_LLM_CORRELATION_MODEL=sonnet-4.5
AIRP_LLM_RCA_MODEL=sonnet-4.6
AIRP_LLM_REMEDIATION_MODEL=sonnet-4.6
AIRP_LLM_DOCUMENTATION_MODEL=sonnet-4.5
AIRP_LLM_EMBEDDING_MODEL=embeddings
AIRP_GATEWAY_MAX_RETRIES=0
AIRP_EMBEDDING_ENABLED=true
AIRP_EMBEDDING_MAX_TEXTS=16
AIRP_EMBEDDING_TEXT_MAX_CHARS=750
AIRP_EMBEDDING_TOTAL_MAX_CHARS=3000
AIRP_EMBEDDING_RATE_LIMIT_COOLDOWN_SECONDS=120

# Read-only evidence MCP integrations
AIRP_AGENT_READ_ONLY_EVIDENCE_ENABLED=true
# RCA hypotheses scoring below this are forced to manual SRE triage. Raise to
# demand stronger evidence, lower to let thin-evidence hypotheses stand.
AIRP_RCA_MIN_HYPOTHESIS_CONFIDENCE=0.4
AIRP_DOCKERHUB_BASE_URL=https://hub.docker.com/v2
AIRP_DOCKERHUB_READ_TIMEOUT_SECONDS=20
AIRP_KUBERNETES_MCP_MODE=fixture
AIRP_KUBECONFIG_HOST_PATH=/Users/your-user/.kube/config
AIRP_KUBERNETES_KUBECONFIG=/tmp/kubeconfig
AIRP_KUBERNETES_CONTEXT=
AIRP_KUBERNETES_DEFAULT_NAMESPACE=shopfast
AIRP_KUBERNETES_MCP_RUN_AS_UID=1000
AIRP_KUBERNETES_MCP_RUN_AS_GID=1000
AIRP_KUBERNETES_MCP_TRANSPORT=mcp
AIRP_KUBERNETES_MCP_URL=http://kubernetes-mcp:8080
AIRP_KUBERNETES_MCP_NAMESPACE_ALLOWLIST=["airp","shopfast","payments","catalog"]
AIRP_KUBERNETES_MCP_READ_TIMEOUT_SECONDS=20
AIRP_GITHUB_MCP_TRANSPORT=mcp
AIRP_GITHUB_MCP_URL=http://github-mcp:8080
AIRP_GITHUB_MCP_REPOSITORY_ALLOWLIST=["AIRP-client/*"]
AIRP_GITHUB_MCP_READ_TIMEOUT_SECONDS=20
AIRP_MCP_READ_RETRY_ATTEMPTS=2
AIRP_MCP_READ_RETRY_MIN_BACKOFF_SECONDS=0.1
AIRP_MCP_READ_RETRY_MAX_BACKOFF_SECONDS=1.0

# Optional GitHub App credentials for live local GitHub MCP.
# Prefer AIRP_GITHUB_APP_PRIVATE_KEY_B64 for Docker Compose .env files:
# base64 -w 0 path/to/github-app-private-key.pem
AIRP_GITHUB_APP_ID=
AIRP_GITHUB_APP_CLIENT_ID=
AIRP_GITHUB_APP_PRIVATE_KEY=
AIRP_GITHUB_APP_PRIVATE_KEY_B64=
AIRP_GITHUB_APP_PRIVATE_KEY_FILE=
AIRP_GITHUB_APP_INSTALLATION_ID=
AIRP_GITHUB_APP_ORG=AIRP-client
AIRP_GITHUB_API_BASE_URL=https://api.github.com
AIRP_GITHUB_APP_API_TIMEOUT_SECONDS=20

# External write actions. Keep disabled unless you intend to create real issues/messages.
AIRP_GITHUB_ISSUE_CREATION_ENABLED=false
AIRP_SLACK_NOTIFICATIONS_ENABLED=false
AIRP_SLACK_WEBHOOK_URL=
AIRP_SLACK_DEFAULT_CHANNEL=#airp-alerts
AIRP_SLACK_SIGNING_SECRET=
AIRP_REMEDIATION_PR_CREATION_ENABLED=false
AIRP_DOCUMENTATION_PUBLISHING_ENABLED=false

# Local Kafka (plaintext).
# Use kafka:9092 when running inside Docker Compose (alert-consumer/api containers).
# Use localhost:9092 when running the app directly on your host machine.
# For Azure Event Hubs swap to SASL_SSL + credentials below.
AIRP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AIRP_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# AIRP_KAFKA_SASL_MECHANISM=PLAIN
# AIRP_KAFKA_USERNAME=$ConnectionString
# AIRP_KAFKA_PASSWORD=
AIRP_KAFKA_ALERTS_RAW_TOPIC=airp.alerts.raw
AIRP_KAFKA_INCIDENTS_VALIDATED_TOPIC=airp.incidents.validated
AIRP_KAFKA_DEADLETTER_TOPIC=airp.deadletter
AIRP_KAFKA_ALERT_CONSUMER_GROUP=airp-alert-consumer
AIRP_KAFKA_AUTO_OFFSET_RESET=earliest
AIRP_KAFKA_ALERT_AUTO_OFFSET_RESET=latest
AIRP_KAFKA_CONSUMER_POLL_TIMEOUT_SECONDS=1
AIRP_KAFKA_CONSUMER_IDLE_LOG_SECONDS=30
AIRP_KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
AIRP_KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
AIRP_KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000
AIRP_ALERT_DEDUPE_TTL_SECONDS=3600

# Temporal
AIRP_TEMPORAL_ADDRESS=localhost:7233
AIRP_TEMPORAL_NAMESPACE=default
AIRP_TEMPORAL_TASK_QUEUE=airp-incident-workflows
AIRP_TEMPORAL_TLS=false
AIRP_TEMPORAL_START_WORKFLOWS=true
AIRP_TEMPORAL_WORKFLOW_TASK_TIMEOUT_SECONDS=60
AIRP_TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=2
AIRP_TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=1
AIRP_TEMPORAL_WORKER_MAX_WORKFLOW_TASK_POLLS=2
AIRP_TEMPORAL_WORKER_MAX_ACTIVITY_TASK_POLLS=1
AIRP_TEMPORAL_WORKER_MAX_ACTIVITIES_PER_SECOND=0.5
AIRP_TEMPORAL_WORKER_ACTIVITY_EXECUTOR_THREADS=2

# Remaining settings with defaults that rarely need changing. Listed so the
# full surface is discoverable; uncomment to override.
# AIRP_API_PREFIX=/api
# AIRP_READINESS_ACTIVE_CHECKS_ENABLED=false
# AIRP_CLIENT_GITHUB_ORG=AIRP-client
# AIRP_AZURE_SUBSCRIPTION_ID=
# AIRP_AZURE_RESOURCE_GROUP=
# AIRP_AZURE_AKS_CLUSTER_NAME=
